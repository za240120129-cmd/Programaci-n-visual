# Bucle while simple
x = 0
while x < 3:
    print(x)
    x += 1
# Salida: 0, 1, 2

# Bucle for simple
for i in range(3):
    print(i)
# Salida: 0, 1, 2

# Bucle for con continue
for i in range(3):
    if i == 1:
        continue
    print(i)
# Salida: 0, 2

# Bucle while con break
x = 0
while True:
    print(x)
    if x == 2:
        break
    x += 1
# Salida: 0, 1, 2

# Operaciones lógicas y condicionales
