# Función que suma e imprime
def funcion_suma(a, b):
    print("La suma es", a + b)

funcion_suma(3, 5)
# Salida: La suma es 8

# Función que suma y retorna
def funcion_suma(a, b):
    return a + b

suma = funcion_suma(3, 5)
print("La suma es", suma)
# Salida: La suma es 8

# Lambda para sumar
print("La suma es", (lambda a, b: a + b)(3, 5))
# Salida: La suma es 8

